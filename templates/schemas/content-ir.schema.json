{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sense Deck Content IR",
  "type": "object",
  "required": ["title", "audience", "theme", "features", "slides"],
  "properties": {
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "audience": { "type": "string" },
    "scenario": { "type": "string" },
    "tone": { "type": "string" },
    "language": { "type": "string" },
    "theme": { "type": "string" },
    "features": {
      "type": "object",
      "required": ["gesture", "presenterMode"],
      "properties": {
        "gesture": { "enum": ["off", "motion-lite", "mediapipe-hand"] },
        "presenterMode": { "type": "boolean" },
        "typstHandout": { "type": "boolean" }
      }
    },
    "sourceSummary": {
      "type": "object",
      "properties": {
        "thesis": { "type": "string" },
        "keyArguments": { "type": "array", "items": { "type": "string" } }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "title", "layout", "theme", "visibleContent", "speakerNotes"],
        "properties": {
          "role": { "type": "string" },
          "title": { "type": "string" },
          "layout": { "type": "string" },
          "theme": { "type": "string" },
          "animations": { "type": "array", "items": { "type": "string" } },
          "canvasFx": { "type": ["string", "null"] },
          "visibleContent": { "type": "object" },
          "speakerNotes": { "type": "string" }
        }
      }
    }
  }
}
